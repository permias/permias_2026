# Copy this file to .env and fill in your values.

# Gemini (Google AI Studio) API key — get one at https://aistudio.google.com/apikey
# Alternative env names if you already use them elsewhere:
# GOOGLE_API_KEY or (legacy) VERTEX_API_KEY
GEMINI_API_KEY=your_api_key_here

# Default model (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated fallbacks if the primary model fails (404/400)
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-2.0-flash-lite

# Comma-separated browser origins for CORS. Use your real site in production (not *).
# CORS_ORIGINS=https://www.permiasnasional.com,https://permiasnasional.com

# Behind nginx/caddy: trust X-Forwarded-For so per-IP rate limits use the real client.
# TRUST_X_FORWARDED_FOR=1

# Throttle expensive Gemini calls per IP (Flask-Limiter). Example: 30 per minute, 2 per second
# CHAT_RATE_LIMIT=20 per minute

# Shared rate-limit store for multiple gunicorn workers (default: in-memory)
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379

# Reject very large JSON bodies to /api/... (bytes)
# MAX_REQUEST_BYTES=65536

# Outbound email — chapter registration (/api/chapter-register) + contact form (/api/contact)
CHAPTER_REGISTER_TO=info@permiasnasional.com
CONTACT_TO=info@permiasnasional.com
# CHAPTER_REGISTER_RATE_LIMIT=5 per minute
# CONTACT_RATE_LIMIT=10 per minute

# Option A — SMTP (e.g. Gmail with an app password — set up when ready for production)
# Create at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=PERMIAS Nasional <your-account@gmail.com>
# MAIL_FROM=PERMIAS Nasional <your-account@gmail.com>

# Local dev only — log form emails to the Flask console instead of sending (no app password needed yet)
MAIL_DEV_LOG=true

# Option B — Resend (https://resend.com) — verified domain in MAIL_FROM
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=PERMIAS Nasional <noreply@permiasnasional.com>

# Flask
FLASK_DEBUG=false
PORT=5001